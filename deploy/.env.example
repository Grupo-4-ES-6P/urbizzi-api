POSTGRES_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@urbizzi.com
ADMIN_PASSWORD=troque-esta-senha

# latest = branch main | dev = branch dev
URBIZZI_TAG=latest
WEB_PORT=8080
API_PORT=3001

# Só para docker-compose.build.yml: caminho do repo do front
WEB_PATH=../../urbizzi-web

# Link de redefinição de senha aponta para cá
APP_URL=http://localhost:8080

# E-mail (opcional). Sem SMTP_HOST, o link aparece em `docker compose logs api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
