PORT=3001
DATABASE_URL=postgres://user:senha@localhost:5432/urbizzi
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1h

# Aplica as migrations ao iniciar a API
RUN_MIGRATIONS=true

# Admin criado no primeiro start (se ainda não existir)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@urbizzi.com
ADMIN_PASSWORD=troque-esta-senha

# Endereço do front, usado no link de redefinição de senha
APP_URL=http://localhost:8080

# E-mail (opcional). Sem SMTP_HOST, o link de redefinição aparece no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
